{
  "name": "sigil",
  "version": "0.1.0",
  "private": true,
  "description": "Dynamically generated, always-reliable SVG stat cards for your GitHub profile README.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc -p action/tsconfig.json",
    "action": "tsx action/render.ts"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "satori": "^0.12.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4",
    "typescript": "^5.7.2",
    "vitest": "2.1.8",
    "wrangler": "^3.114.17"
  },
  "packageManager": "pnpm@9.15.9"
}
